# Mission Assistant (Scenario Comparison) settings.
#
# Copy this file to backend/.env (git-ignored) and fill in the key. backend/.env is read on every request,
# so after saving it press "Check again" in the assistant panel; no backend restart is needed.
# Never commit a real key, and never put it in frontend code: the browser only talks to this backend.

# Required for the assistant. An OpenRouter key (https://openrouter.ai/keys), starts with sk-or-v1-
OPENROUTER_API_KEY=

# Optional: any OpenRouter model id (default openai/gpt-4o-mini)
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: another OpenAI-compatible endpoint (default https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: your public frontend URL for OpenRouter attribution
# OPENROUTER_HTTP_REFERER=https://your-frontend.example.com

# Optional: seconds to wait for an answer (default 45)
# ASSISTANT_TIMEOUT_S=45

# For separate frontend/backend deployments, allow the frontend's exact origin(s), comma-separated.
# Wildcard (*) is ignored for security. Omit for local development or single-origin reverse proxy.
# CORS_ALLOW_ORIGINS=https://your-frontend.xyz

# Production hardening controls (defaults shown):
# LUNAR_OFFLINE=1                  # Recommended when deploying with pre-warmed terrain/sites only
# TRUST_PROXY_HEADERS=1            # Enable only when running behind a trusted reverse proxy / Cloudflare
# RATE_LIMIT_CHAT_PER_MIN=30       # Per-IP limit on POST /api/assistant/chat
# RATE_LIMIT_CUSTOM_SITE_PER_MIN=20
# RATE_LIMIT_RESCUE_PER_MIN=60
# MAX_CUSTOM_SITES=100             # Max cached custom-site JSON files kept on disk
